# ============================================================
#  个人工作台 —— 环境变量模板
#  用法：cp .env.example .env  然后按需修改
#  .env 已被 .gitignore / .dockerignore 排除，不会进镜像和仓库
#
#  说明：公开服务骨架只消费 PORT / HOST；
#  其余变量供私有完整版（学习通同步、AI、浏览器内核）使用，
#  骨架不读取，保留在此作为自建同类系统的配置参考。
# ============================================================

# ---------- 服务 ----------
# 监听端口。部署平台若注入 PORT，会自动以平台为准
PORT=3000
# 监听地址。本机/容器里保持 0.0.0.0；只给本机反代用可改 127.0.0.1
HOST=0.0.0.0
# 数据目录（state.json / session.json 落在这里）。
# 用 Docker 时把它挂到 volume，容器重建数据也不会丢
DATA_DIR=./data
# 时区（完整版的课表/待办按此时区计算；骨架不消费）
TZ=Asia/Shanghai
# 完整版页面访问口令（骨架无鉴权，不读取；私有完整版必填长随机串）
# APP_TOKEN=change_me_to_a_long_random_token

# ---------- 学习通（只在服务端使用，永不下发浏览器）----------
CX_PHONE=your_chaoxing_phone
CX_PASSWORD=your_chaoxing_password
# true = 启动即自动登录并预热数据
CX_AUTO_LOGIN=true
# 后台定时同步间隔（分钟）。0 = 关闭。
# 自己的服务器上建议开 30，这样 AI 随时都有最新数据，不用现场等
CX_SYNC_INTERVAL_MIN=30

# ---------- StepFun（AI 智能体）----------
# 不填则用内置默认值；Key 只存在服务端
STEPFUN_KEY=your_stepfun_api_key
STEPFUN_BASE=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-5-preview

# ---------- 自托管专属：真实浏览器深度解析 ----------
# 1 = 开启 Playwright「深度解析」能力（真开一个 Chromium 去渲染学习通内页，
#     把作业要求、考试范围、章节内容等完整读出来）。
# 需要先在本机装好浏览器内核：npx playwright install --with-deps chromium
# 无桌面环境的托管沙箱内通常没有浏览器内核，该能力仅在自有服务器上开启
BROWSER_MODE=1
# 浏览器内核路径。留空则用 Playwright 默认缓存位置
# CHROME_PATH=/usr/bin/chromium
# 单次深度解析超时（毫秒）
BROWSER_TIMEOUT=25000
